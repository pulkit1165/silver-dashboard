# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local ERP database
/.data/

# cloud-sync (iCloud/Dropbox/Drive) conflict copies — junk, never commit.
# Matches "name 2.ts", "route 3.tsx", "backfill 9.mjs", etc.
* [0-9].*
* [0-9][0-9].*
*(conflicted copy*
* copy.*
* copy [0-9].*
.icloud
*.icloud
